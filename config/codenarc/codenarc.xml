<?xml version="1.0" encoding="UTF-8"?>
<ruleset xmlns="http://codenarc.org/ruleset/1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://codenarc.org/ruleset/1.0 http://codenarc.org/ruleset-schema.xsd">

    <description>
        CodeNarc's Groovy-side equivalent of the detekt setup every Android app in
        this workspace runs - real bugs and dead code, not formatting nitpicks.
    </description>

    <ruleset-ref path="rulesets/basic.xml"/>
    <ruleset-ref path="rulesets/braces.xml"/>
    <ruleset-ref path="rulesets/exceptions.xml"/>
    <ruleset-ref path="rulesets/imports.xml"/>
    <ruleset-ref path="rulesets/unused.xml"/>
    <ruleset-ref path="rulesets/unnecessary.xml">
        <!-- This codebase consistently and deliberately uses double-quoted strings
             throughout - a valid, uniform Groovy style choice, not a defect. Excluded
             rather than fixed to avoid a 44-line no-op diff across working,
             carefully-commented release-automation code. -->
        <exclude name="UnnecessaryGString"/>
    </ruleset-ref>
</ruleset>
